# Copiar solo al almacén de Secrets de Supabase; no publicar los valores reales.
CRON_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cuenta-remitente@example.com
SMTP_PASSWORD=CAMBIAR_POR_PASSWORD_DE_APLICACION
SMTP_FROM=cuenta-remitente@example.com
ALERT_TO=destinatario-interno@example.com
# true obliga modo simulado, incluso si SMTP está configurado.
DEMO_MODE=true
APP_URL=https://TU-DOMINIO-DE-LA-APP
